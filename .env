# Spotfire Copilot 백엔드 환경 변수 (Ollama + Redis 구성)
# 참고: "Getting Started with Spotfire Copilot - Backend Infrastructure Setup" Appendix

LOG_LEVEL=INFO

# JWT 토큰 서명용 시크릿 키 (openssl rand -hex 32 로 생성)
SECRET_KEY=88f98bc993557c2452602126f6365bd3e8967520103ee01d0eb01a216a46c295

# admin 계정의 bcrypt 해시 비밀번호. (https://bcrypt-generator.com/ 에서 생성)
# 비밀번호를 바꾸려면 새 평문을 해시로 만들어 아래 값을 통째로 교체할 것.
# bcrypt 는 단방향이라 여기 적어둔 해시만 보고 평문을 알 수 없다 - 평문은 별도로
# 안전하게 보관해 둘 것 (이 파일에 평문으로 적지 말 것).
# 주의: docker compose 가 "$" 를 변수로 해석하므로 해시 안의 "$" 는 모두 "$$" 로 바꿔야 함 (PDF 17p)
HASHED_ADMIN_PASSWORD=$$2a$$12$$EQtmC0JrzmO0AZbmThJEne5OP84zGRAsARpTcyethrGtNHEs8HiEu

ACCESS_TOKEN_EXPIRE_DAYS=7

# Spotfire Preferences 의 Orchestrator Client ID / Client Secret 과 일치해야 함.
#
# 2.3.0 은 OAUTH2_CLIENT_ID / OAUTH2_CLIENT_SECRET_HASH 를 쓴다.
# 설정하지 않으면 기동 로그에 이렇게 뜨고 임의 클라이언트를 자동 생성해버려서
# Spotfire 가 설정한 자격증명으로는 인증이 안 된다:
#   OAUTH2_CLIENT_ID / OAUTH2_CLIENT_SECRET_HASH not set - falling back to auto-generated client
#
# SECRET 은 평문이 아니라 bcrypt 해시로 넣어야 하고, compose 가 "$" 를 변수로
# 해석하므로 해시 안의 "$" 는 전부 "$$" 로 써야 한다.
# 아래 값은 평문 "spotfire" 의 해시임. 다른 secret 을 쓰려면 컨테이너에서 생성:
#   docker exec copilot-orchestrator /app/venv/bin/python -c \
#     "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('원하는값'))"
OAUTH2_CLIENT_ID=spotfire
OAUTH2_CLIENT_SECRET_HASH=$$2b$$12$$UwIWxap4z1zqs74ZXUR3WO7HeRWWJG5e30/XNvwXj8KLI7W4v80AC

# 2.0.0 시절 우리 자체 패치(/client/token)가 쓰던 변수. 2.3.0 에서는 안 쓰이지만
# ORCHESTRATOR_TAG 를 되돌릴 때를 위해 남겨둠.
COPILOT_CLIENT_ID=spotfire
COPILOT_CLIENT_SECRET=spotfire

# Data Loader 에 마운트할 PDF 문서 폴더 (호스트 경로)
DOCS_DIR=./docs

# ── 이미지 버전 ─────────────────────────────────────────
# 프론트엔드(Analyst 의 Copilot 모듈)와 백엔드 버전이 맞아야 함.
# latest 는 FASTAPI_APP_VERSION=2.0.0 이라, 프론트엔드가 2.3.4 면 뒤처진 상태이고
# /agents/available·/threads 404, 스크린샷 미전송 같은 증상이 나타난다.
#
# 사용 가능한 태그: https://gallery.ecr.aws/tds/llm-orchestrator 의 Image tags 탭
#
# 조회한 실제 태그 목록:
#   llm-orchestrator        : 2.3.0, 2.1.0, 2.0.4, 2.0.3, 2.0.2, 2.0.0, latest(=2.0.0)
#   data-loader-pdf-unstruct: 2.1.0, 2.0.0, 0.18, latest
# 2.3.4 는 없고 2.3.0 이 프론트엔드 2.3.4 와 같은 계열이라 가장 가깝다.
ORCHESTRATOR_TAG=2.3.0
DATA_LOADER_TAG=latest

# orchestrator_main.py 패치를 어디에 마운트할지.
# /app/main.py 로 두면 패치 적용, /tmp/... 로 두면 비활성(이미지 원본 사용).
#
# 우리 패치 파일은 2.0.0 의 main.py 기반이라 2.3.0 에 덮어씌우면 그 버전의
# 새 엔드포인트가 사라진다. 그래서 2.3.0 을 쓰는 동안은 비활성이 기본.
# 2.0.0(latest)으로 되돌릴 때는 /app/main.py 로 바꿀 것.
ORCHESTRATOR_MAIN_TARGET=/tmp/orchestrator_main_disabled.py

# ── Plugins ─────────────────────────────────────────────
# Data Loader 용
VECTORDB_PLUGIN_ENTRY_POINT=plugins.vectordbs.redis:RedisRetrieverPlugin
# data-loader 이미지는 2.0.0 계열이라 ollama_enhanced 모듈이 없다.
# orchestrator 와 같은 값을 쓰면 여기서 크래시 루프가 난다.
DATA_LOADER_MODEL_PLUGIN_ENTRY_POINT=plugins.models.ollama:OllamaPlugin
# Orchestrator 용
RETRIEVER_PLUGIN_ENTRY_POINT=plugins.retrievers.redis:RedisRetrieverPlugin
# 공통 (LLM / Embedding = Ollama)
#
# orchestrator 2.3.0 은 모델 플러그인이 getModelByCategory() 를 구현하도록 요구한다.
# 예전 plugins.models.ollama:OllamaPlugin 을 쓰면 기동 시 이렇게 죽는다:
#   FATAL: Plugin class 'OllamaPlugin' does not implement getModelByCategory().
# 이미지가 제시하는 대체 경로가 plugins.models.ollama_enhanced:OllamaPlugin 이다.
# (2.0.0 으로 되돌릴 때는 _enhanced 를 떼야 함 — 그 버전엔 없는 모듈)
MODEL_PLUGIN_ENTRY_POINT=plugins.models.ollama_enhanced:OllamaPlugin
SECONDARY_MODEL_PLUGIN_ENTRY_POINT=plugins.models.ollama_enhanced:OllamaPlugin
# 임베딩·검색기는 enhanced 요구가 없어서 그대로 둔다.
# 기동 로그에 같은 형태의 FATAL 이 나오면 그때 해당 항목도 _enhanced 로 바꿀 것.
EMBEDDINGS_PLUGIN_ENTRY_POINT=plugins.embeddings.ollama:OllamaEmbeddingsPlugin

# ── Models ──────────────────────────────────────────────
# 호스트 PC 의 Ollama 에 미리 받아둔 모델명과 일치해야 함 (ollama list 로 확인)
# MODEL_NAME / MULTI_MODAL_MODEL_NAME 은 이미지 요약·화면 판독에 쓰이므로
# 반드시 비전(멀티모달) 모델이어야 함 (llama3.1 같은 텍스트 모델 불가)
#
# llava:7b -> qwen2.5vl:7b 로 교체함. llava 는 대시보드처럼 축 레이블·범례·숫자가
# 빽빽한 이미지를 거의 못 읽음. qwen2.5vl 은 차트/문서 판독과 한국어가 훨씬 낫고
# 컨텍스트도 128k 라 스크린샷 + 질문 + 히스토리를 함께 담기 좋음.
# (참고: 벤더 가이드의 기준 모델은 gpt-4o 급이라 로컬 모델은 그보다 낮음)
MODEL_NAME=qwen2.5vl:7b
# 한국어 의미 검색을 위해 다국어 임베딩 bge-m3 사용 (nomic-embed-text 는 영어 위주라 한국어 검색 부정확)
# 변경 시 반드시 문서를 재적재(drop_old=true)해야 함 (벡터 차원/공간이 달라짐)
EMBEDDING_MODEL_NAME=bge-m3
MULTI_MODAL_MODEL_NAME=qwen2.5vl:7b
COMPLETIONS_MODEL_NAME=qwen2.5
# 인텐트 분류(CHAT_SIMPLE)·데이터질문 SQL생성(CHAT_COMPLEX)에 쓰임.
# qwen2.5 가 llama3.1 보다 구조적 출력/SQL/한국어가 우수 → 분류·데이터질문 정확도 개선용.
CHAT_SIMPLE_MODEL_NAME=qwen2.5
CHAT_COMPLEX_MODEL_NAME=qwen2.5

# ── 화면 스크린샷 축소 ──────────────────────────────────
# Spotfire 는 페이지 스크린샷을 원본 해상도(4K)로 보낸다. 비전 모델은 이미지를
# 패치 토큰으로 바꾸므로 4K 한 장이 4000~5000 토큰을 먹고, 그러면
#   - 컨텍스트를 키우면 CPU 환경에서 수 분이 걸려 Analyst 가 타임아웃하고
#   - 컨텍스트를 줄이면 "exceeds the available context size" 로 거부당한다
# 최대 변을 1280 으로 줄이면 토큰이 대략 1/9 이 된다. 축과 범례를 읽는 데는
# 이 정도면 대개 충분하다. 0 으로 두면 축소하지 않는다.
#
# 비전 모델의 비용은 파일 크기가 아니라 '해상도'에만 비례한다. Qwen2-VL 계열은
# 28x28 픽셀 블록 하나가 토큰 하나다. 그래서 JPEG 로 압축해도 토큰은 1개도 안 준다.
#
#   3840x2160 (4K)  ~10500 토큰   <- 지금까지 이걸 보내고 있었다. CPU 로는 불가능
#   1920x1080        ~2600 토큰
#   1280x720         ~1125 토큰
#   1024x576          ~720 토큰
#    768x432          ~405 토큰   <- 웬만한 텍스트 프롬프트보다 싸다
#    640x360          ~264 토큰
#
# 768 이면 축 레이블과 범례는 대개 읽히고, 비용은 4K 의 1/26 이다.
# 판독이 부정확하면 1024 로 올릴 것(토큰 1.8배). 그래도 느리면 640 으로 낮출 것.
COPILOT_IMAGE_MAX_EDGE=768

# 전송/메모리만 줄이는 설정들. 토큰 수에는 영향이 없다.
# jpeg 70 이면 4K PNG 기준 base64 가 2MB -> 60KB 수준으로 준다.
COPILOT_IMAGE_FORMAT=jpeg
COPILOT_IMAGE_QUALITY=70
# 흑백은 전송량만 더 줄지만 색으로 구분되는 범례를 망친다. 기본은 꺼 둔다.
COPILOT_IMAGE_GRAY=0

# shrink = 스크린샷을 줄여서 비전 모델로 보냄
# off    = 스크린샷을 아예 빼고, Spotfire 가 같이 보내는 시각화 메타데이터(텍스트)만
#          모델에 넘김.
#
# shrink 로 되돌린다. 앞서 off 로 둔 이유는 "이미지는 CPU 로 감당 못 한다" 였는데,
# 아래 해상도 표를 보면 그건 정확히는 "4K 를 감당 못 한다" 였다.
# 768px 스크린샷은 약 400 토큰으로, 시각화 메타데이터 텍스트보다도 싸다.
# 모델도 3B 하나로 통일돼 비전용 러너를 따로 띄우지 않는다.
#
# 그래도 화면 질문만 느리면 off 로 되돌릴 것. 그때는 Spotfire 가 함께 보내는
# 시각화 메타데이터(차트 종류·축 컬럼·필터·마킹)만으로 답한다.
COPILOT_VISION_MODE=shrink

# Pillow 가 없거나 이미지 디코딩에 실패했을 때: keep=원본 4K 를 그대로 전송(=예전 실패),
# drop=이미지 제거. drop 이면 최소한 요청이 완료되고 로그에 원인이 남는다.
COPILOT_IMAGE_ON_ERROR=drop

# ── 응답 시간 상한 ─────────────────────────────────────
# "took too long" 은 프리필만의 문제가 아니다. 요청 하나의 시간은
#   프리필(입력 읽기) + 모델 로드 + 생성(답 쓰기)
# 셋으로 나뉘고, 위 VISION_MODE 는 첫 번째만 줄인다. 나머지 둘은 여기서 잡는다.

# 생성 길이 상한. CPU 에서 7B 는 초당 5~10 토큰이라, 모델이 800 토큰짜리 장문을
# 쓰기로 하는 순간 그것만으로 2분이 나간다. 256 이면 대략 30~50초.
# 답이 중간에 잘리면 조금씩 올릴 것(384, 512).
COPILOT_NUM_PREDICT=256

# 컨텍스트 크기. 이미지를 빼면 입력이 2000 토큰 안쪽이라 8192 로 충분하고,
# 크게 잡을수록 KV 캐시가 커져 CPU 에서 느려진다.
# 이 값을 주면 ollama-bigctx.sh 로 만든 모델의 num_ctx 보다 우선한다.
COPILOT_NUM_CTX=8192

# 모델을 메모리에 붙잡아 두는 시간. Ollama 기본은 5분이라, 잠깐 쉬고 질문하면
# 7B 가중치를 디스크에서 다시 읽는다. CPU 장비에서 이것만 10~60초다.
COPILOT_KEEP_ALIVE=2h

# 이미지를 뺐을 때 갈아끼울 텍스트 모델. 비워 두면 모델을 바꾸지 않는다.
# (바꾸면 모델이 하나 더 메모리에 올라와 첫 요청이 오히려 느려진다)
# 그래도 느리면 더 작은 모델로: ollama pull qwen2.5:3b 후 아래에 qwen2.5:3b
COPILOT_TEXT_MODEL=

# ── 입력(프롬프트) 상한 ────────────────────────────────
# 데이터 질문("의사명이 박재윤인 사람의 병원은?")은 화면 해석보다 프롬프트가 크다.
# Copilot 은 질문에 답하려고 테이블 메타데이터 - 컬럼 이름·타입·샘플 값 - 를
# 프롬프트에 통째로 싣는데, 컬럼이 많으면 이것만 수천~수만 토큰이다. 그러면
#   - Ollama 가 "exceeds the available context size" 로 거부하거나
#   - 거부하지 않아도 CPU 프리필이 몇 분 걸려 Analyst 가 끊는다.
# 사용자 눈에는 둘 다 똑같이 실패로 보인다.
#
# 3000 토큰은 CPU 프리필 기준 대략 1분 안쪽이다. 이 값을 올리면 답은 정확해질
# 수 있지만 그만큼 느려지고, 어느 선을 넘으면 다시 타임아웃이 난다.
# 컨텍스트(8192)가 아니라 "시간"이 기준이라는 점에 주의할 것.
COPILOT_MAX_PROMPT_TOKENS=3000

# 유지할 대화 턴 수(system 지시문 제외). 오래된 턴부터 버린다.
COPILOT_MAX_HISTORY=6

# ── SQL/JSON 생성 요청 전용 상한 ───────────────────────
# 위의 일반 상한은 대화용이라 SQL 생성에는 정반대로 해롭다:
#   - 스키마를 자르면 없는 컬럼 이름으로 질의를 만들어 곧바로 실패하고
#   - 출력을 256 토큰에서 끊으면 질의 문법이 깨져 통째로 버려진다
# 그 결과가 "the system was unable to generate a valid query" 다.
#
# 출력 상한은 '상한'일 뿐이라 넉넉히 줘도 모델이 짧게 답하면 시간이 더 들지 않는다.
# 반면 입력 상한은 프리필 시간에 직결되므로 무한정 올릴 수 없다.
# 5000 토큰은 CPU 에서 대략 2분선이니, 여전히 타임아웃이 나면 4000 으로 낮출 것.
COPILOT_SQL_NUM_PREDICT=1024
COPILOT_SQL_MAX_PROMPT_TOKENS=5000

# 이 토큰 수를 넘는 요청은 메시지별 크기를 로그에 풀어서 남긴다.
# docker logs copilot-orchestrator 2>&1 | grep "msg\["
COPILOT_DESCRIBE_OVER=1500

# ── 그 밖의 리소스 절약 ────────────────────────────────
# 문서 검색에서 가져올 청크 수. 검색된 청크는 통째로 프롬프트에 실리고
# 하나가 보통 500~1000 토큰이라, 4 -> 2 로 줄이면 프리필이 절반이 된다.
# 문서 질문의 답이 자꾸 불충분하면 3~4 로 올릴 것.
COPILOT_SEARCH_TOP_K=2

# num_ctx 는 러너(모델 프로세스) 파라미터라 호출마다 값이 다르면 Ollama 가
# 러너를 새로 띄운다 = 매번 모델 재적재. 1 로 두면 벤더가 정한 값을 덮어써서
# 모든 호출을 같은 러너로 몰아준다. 끄지 말 것.
COPILOT_FORCE_OPTIONS=1

# 추론 스레드 수. 0 이면 Ollama 기본값(물리 코어 수)을 쓴다.
# 보통 기본값이 최적이고, 논리 코어 수(하이퍼스레딩 포함)로 올리면 오히려 느려진다.
# 다른 작업과 CPU 를 나눠 써야 할 때만 물리 코어보다 낮게 지정할 것.
COPILOT_NUM_THREAD=0

# 나가는 요청을 통째로 파일에 떨군다. 호스트의 ./copilot-patch-libs/ 아래에
#   last-sql-payload.json   : 마지막 SQL/JSON 생성 요청
#   last-chat-payload.json  : 마지막 일반 대화 요청
# 이 남는다. SQL 생성이 왜 실패하는지 보려면 이 파일을 열어 스키마가 온전한지,
# 질문이 제대로 실렸는지 확인하면 된다. 필요 없어지면 비워 둘 것.
COPILOT_DUMP_DIR=/opt/copilot-patch-libs

# ── 모델 카테고리 (orchestrator 2.3.0+) ────────────────
# 2.3.0 은 모델을 이름이 아니라 카테고리로 고른다(plugins/models/ollama_enhanced.py
# -> model_category_config.py). 변수는 OLLAMA_<카테고리>_MODEL 과
# OLLAMA_<카테고리>_TEMPERATURE 쌍이고, 둘 다 있어야 해당 카테고리가 로드된다.
# 카테고리: fast, large, vision, code, reasoning
#
# 설정하지 않으면 벤더 폴백(fast=llama3.2:3b, large=llama3.1:8b)이 쓰이는데
# llama3.2:3b 는 받아둔 적이 없어서 Ollama 가 404 를 낸다:
#   OllamaEndpointNotFoundError: Ollama call failed with status code 404
# 게다가 없는 카테고리는 fast 로 폴백되므로 vision 요청까지 llama3.2:3b 로 가서
# 화면 판독이 통째로 실패한다. 그래서 5개를 모두 채운다.
#
# !! 다섯 개를 전부 같은 모델로 둔다. 이게 이 장비에서 가장 큰 성능 차이를 만든다.
#
# Ollama 는 모델마다 러너(모델 프로세스)를 따로 띄운다. 전에는 텍스트용 qwen2.5(7B)와
# 비전용 qwen2.5vl(7B)을 나눠 썼는데, 질문 하나가 분류->검색->답변으로 여러 번
# 호출되면서 두 모델을 번갈아 쓰면 그때마다 4~5GB 를 다시 올린다.
# 그 재적재 시간이 실제 추론보다 길었다. 비전 모델은 텍스트도 처리하므로
# 비전 모델 하나로 통일하면 교체 자체가 사라진다.
#
# 7B -> 3B 로 낮춘 이유: CPU 에서 7B 는 프리필 초당 30~50 토큰, 생성 초당 5~8 토큰이다.
# 3B 는 대략 2.5배 빠르고 메모리는 절반이다.
#
# -bigctx 변형은 더 이상 쓰지 않는다. sitecustomize 패치가 요청마다 num_ctx 를
# 실어 보내고 모든 호출에 같은 값을 강제하므로, 모델에 구울 필요가 없다.
#
# !! bash ollama-setup.sh 를 먼저 실행해 모델을 받을 것. 없으면 Ollama 가 404 를 낸다.
#
# SQL 생성 품질이 3B 로 부족하면 code/reasoning 만 7B 로 되돌릴 수 있다. 다만 그
# 순간 모델이 둘이 되어 교체 비용이 돌아오므로, 메모리가 넉넉할 때만 할 것.
OLLAMA_FAST_MODEL=qwen2.5vl:3b
OLLAMA_FAST_TEMPERATURE=0.3
OLLAMA_LARGE_MODEL=qwen2.5vl:3b
OLLAMA_LARGE_TEMPERATURE=0.2
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_VISION_TEMPERATURE=0.2
OLLAMA_CODE_MODEL=qwen2.5vl:3b
OLLAMA_CODE_TEMPERATURE=0.1
OLLAMA_REASONING_MODEL=qwen2.5vl:3b
OLLAMA_REASONING_TEMPERATURE=0.2

# ── Ollama ──────────────────────────────────────────────
# 컨테이너에서 호스트 PC 의 Ollama(11434 포트)로 접근
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 모델 컨텍스트 크기(토큰). 미지정 시 플러그인 기본값 8192.
# 스크린샷 한 장이 수천 토큰을 먹으므로 화면 판독을 쓰면 넉넉히 잡아야 함.
# 참고: 이 값은 docker-compose.yml 에 전달 설정이 없어서 그동안 적용되지 않았음(수정됨).
CHAT_NUM_CTX=16384

# ── PostgreSQL (orchestrator 2.3.0+ 의 대화 스레드 저장소) ──
# 2.3.0 은 기동 시 alembic 마이그레이션을 돌리는데, DB 가 없으면 실패해서
# API 자체가 안 뜬다(2.0.0 에는 없던 요구사항).
#
# 이미지에는 POSTGRES_* 기본값이 없어서(env 확인 결과 FASTAPI_APP_VERSION 뿐)
# 아래 값을 반드시 밖에서 넣어줘야 함. 이 조합으로 마이그레이션 성공을 확인했다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrator
POSTGRES_HOST=orchestrator-postgres
POSTGRES_PORT=5432

# 드라이버를 반드시 asyncpg 로 지정해야 함.
# 앱 본체(shared/fastapi_users_config.py)는 create_async_engine 을 쓰는데,
# postgresql:// 로 두면 동기 드라이버(psycopg2)가 물려서
# "The asyncio extension requires an async driver" 로 죽는다.
# alembic 마이그레이션은 별도로 동기 URL 을 만들어 쓰므로 영향 없음.
#
# 그래도 같은 오류가 나면 이 줄을 통째로 비워서(DATABASE_URL=) 앱이
# POSTGRES_* 조합으로 직접 URL 을 만들게 해볼 것.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@orchestrator-postgres:5432/orchestrator

# ── VectorDB (Redis) ────────────────────────────────────
# 같은 docker 네트워크 안의 redis 서비스명으로 접근
REDIS_URL=redis://redis:6379/0

# Redis 키 접두사. 검색 시 이 값이 실제 저장된 키의 접두사와 다르면
# 오류 없이 검색 결과가 0건이 된다(답변은 "문서에서 찾을 수 없습니다", sources 는 빈 채).
#
# 현재 적재된 문서의 키는 전부 summary:* 이므로 반드시 summary 여야 함.
# 비워두면 코드가 인덱스 이름을 접두사로 계산하는데, 그러면 기존 문서를 못 찾는다.
#
# 재적재할 때 이 값을 비우면 인덱스 이름이 접두사가 되어 문서 집합이 인덱스별로
# 분리된다(지금은 6개 인덱스가 summary 를 공유해 전부 같은 문서를 봄).
# Spotfire 매뉴얼을 따로 적재하려면 그 분리가 필요함.
REDIS_KEY_PREFIX=summary

# ── 인덱스 이름 교정 ────────────────────────────────────
# prompts.py 는 User_Docs 를 "petroleumreservoir"(벤더 데모용), HowTo 를
# "spotfiredocs" 로 하드코딩해 둠. 실제 적재한 인덱스 이름을 여기에 지정해야
# 검색이 됨. 비워두면 하드코딩된 이름을 그대로 쓰므로 검색 결과가 0건이 됨.
#
# 주의: User_Docs 는 인덱스를 하나만 봄. 여러 문서를 한꺼번에 검색하려면
#       하나의 인덱스에 모두 적재해야 함.
#
# 현재는 키 접두사가 전부 "summary" 로 겹쳐 있어서(재적재 전) 어느 이름을 넣든
# 적재된 문서 전체가 검색됨. 재적재 후에는 이 이름이 실제로 문서 집합을 가르므로
# 그때 적재에 쓴 인덱스 이름으로 반드시 바꿔야 함.
COPILOT_USER_DOCS_INDEX=yh42946protocol
# /load_spotfire_docs 로 Spotfire 매뉴얼을 적재한 인덱스명 (보통 spotfiredocs)
COPILOT_SPOTFIRE_DOCS_INDEX=

# ── 인텐트 라벨 교정 ────────────────────────────────────
# 비워두면 이미지 내장 분류기의 라벨을 그대로 사용(기본).
# Analyst 가 "Error determining intent" 로 거부할 때만 실제 라벨 목록을 지정.
COPILOT_INTENT_LABELS=
COPILOT_INTENT_DEFAULT=

# ── 대화 스레드 스텁 (실험용) ───────────────────────────
# 프론트엔드가 POST /threads 로 스레드를 만들려다 404 를 받고 축소 모드로
# 동작하면서 스크린샷 첨부를 건너뛰는 것인지 확인하기 위한 스텁.
# 응답 구조를 모르는 추정 구현이라 기본은 꺼 둠. true 로 켠 뒤 Analyst 가
# 이상해지면 다시 비우면 됨.
COPILOT_THREAD_STUBS=

# ── Optional monitoring (Langsmith) ─────────────────────
# 주의: LANGCHAIN_ENDPOINT 가 빈 값이면 orchestrator 가
# "LangSmith API URL cannot be empty" 오류로 종료됨 → 기본 URL 유지
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=spotfire-copilot
